#include <zephyr/dt-bindings/regulator/nrf5x.h>

/ {
	soc {
		sram_app: memory@20006000 {
			compatible = "mmio-sram";
			reg = <0x20006000 0x3a000>;
		};
	};

	chosen {
		zephyr,sram = &sram_app;
	};
};

&reg1 {
	regulator-initial-mode = <NRF5X_REG_MODE_LDO>;
};

&uart0 {
	status = "okay";
	current-speed = <1000000>;
};
